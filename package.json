{
  "name": "fridge-to-fork",
  "version": "1.0.0",
  "private": true,
  "description": "AI recipe maker: turn the ingredients you have into three recipes using Google Gemini (free tier) or Anthropic Claude.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "check-key": "node --env-file-if-exists=.env scripts/check-key.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "express": "^4.22.3"
  }
}
